 #include "jni_util.h"
 #include "request_context_handler.h"
 
+namespace {
+
+// Keep the Java wrapper, not another native context reference. After FinishDispose,
+// the completion task retains only the callback; it cannot keep the profile alive.
+class FlushAndReleaseContext : public CefCompletionCallback {
+ public:
+  FlushAndReleaseContext(JNIEnv* env, jobject context, jobject callback)
+      : context_(env, context), callback_(new CompletionCallback(env, callback)) {}
+
+  void OnComplete() override {
+    CefPostTask(TID_UI, base::BindOnce(&FlushAndReleaseContext::FinishDispose,
+                                     CefRefPtr<FlushAndReleaseContext>(this)));
+  }
+
+ private:
+  void FinishDispose() {
+    ScopedJNIEnv env;
+    if (!env) return;
+    SetCefForJNIObject<CefRequestContext>(env, context_, nullptr, "CefRequestContext");
+    CefPostTask(TID_UI, base::BindOnce(&CefCompletionCallback::OnComplete, callback_));
+  }
+
+  ScopedJNIObjectGlobal context_;
+  CefRefPtr<CefCompletionCallback> callback_;
+  IMPLEMENT_REFCOUNTING(FlushAndReleaseContext);
+};
+
+}  // namespace
+
+JNIEXPORT jboolean JNICALL
+Java_org_cef_browser_CefRequestContext_1N_N_1FlushAndDispose(
+    JNIEnv* env, jobject obj, jobject callback) {
+  auto context = GetCefFromJNIObject<CefRequestContext>(env, obj, "CefRequestContext");
+  if (!context) return JNI_FALSE;
+  auto manager = context->GetCookieManager(nullptr);
+  if (!manager) return JNI_FALSE;
+  return manager->FlushStore(new FlushAndReleaseContext(env, obj, callback))
+      ? JNI_TRUE : JNI_FALSE;
+}
