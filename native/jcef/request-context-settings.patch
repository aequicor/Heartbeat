+package org.cef;
+
+/** Initialization values copied to CEF 152's cef_request_context_settings_t. */
+public final class CefRequestContextSettings {
+    /** Absolute directory below CefSettings.root_cache_path, or empty for incognito. */
+    public String cache_path = "";
+    /** Persist session cookies as well as cookies with an expiry date. */
+    public boolean persist_session_cookies = false;
+    public String accept_language_list = "";
+    public String cookieable_schemes_list = "";
+    public boolean cookieable_schemes_exclude_defaults = false;
