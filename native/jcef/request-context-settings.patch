+
+// Heartbeat extension: separate JNI wrappers own separate CEF references. Closing
+// a browser disposes only its wrapper, never the profile's anchor context.
+JNIEXPORT jobject JNICALL
+Java_org_cef_browser_CefRequestContext_1N_N_1CreatePersistentContext(
+    JNIEnv* env, jclass cls, jstring cache_path, jboolean persist_cookies,
+    jstring languages, jstring cookie_schemes, jboolean exclude_defaults,
+    jobject jhandler) {
+  CefRequestContextSettings settings;
+  CefString(&settings.cache_path) = GetJNIString(env, cache_path);
+  settings.persist_session_cookies = persist_cookies;
+  CefString(&settings.accept_language_list) = GetJNIString(env, languages);
+  CefString(&settings.cookieable_schemes_list) = GetJNIString(env, cookie_schemes);
+  settings.cookieable_schemes_exclude_defaults = exclude_defaults;
+  CefRefPtr<CefRequestContextHandler> handler;
+  if (jhandler) handler = new RequestContextHandler(env, jhandler);
+  auto context = CefRequestContext::CreateContext(settings, handler);
+  if (!context) return nullptr;
+  ScopedJNIObjectLocal result(env, NewJNIObject(env, cls));
+  if (!result) return nullptr;
+  SetCefForJNIObject(env, result, context.get(), "CefRequestContext");
+  return result.Release();
+}
+
+JNIEXPORT jobject JNICALL
+Java_org_cef_browser_CefRequestContext_1N_N_1CreateSharedContext(
+    JNIEnv* env, jclass cls, jobject shared, jobject jhandler) {
+  auto parent = GetCefFromJNIObject<CefRequestContext>(env, shared, "CefRequestContext");
+  if (!parent) return nullptr;
+  CefRefPtr<CefRequestContextHandler> handler;
+  if (jhandler) handler = new RequestContextHandler(env, jhandler);
+  auto context = CefRequestContext::CreateContext(parent, handler);
+  if (!context) return nullptr;
+  ScopedJNIObjectLocal result(env, NewJNIObject(env, cls));
+  if (!result) return nullptr;
+  SetCefForJNIObject(env, result, context.get(), "CefRequestContext");
+  return result.Release();
 }
 
