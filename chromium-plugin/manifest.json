{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Heartbeat",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/heartbeat-16.png",
    "32": "icons/heartbeat-32.png",
    "48": "icons/heartbeat-48.png",
    "128": "icons/heartbeat-128.png"
  },
  "action": {
    "default_title": "Heartbeat",
    "default_icon": {
      "16": "icons/heartbeat-16.png",
      "32": "icons/heartbeat-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "sidePanel",
    "storage"
  ]
}
