              "layout": "none",
              "children": [
                {
                  "id": "g-tc-run-lc",
                  "type": "frame",
                  "name": "Desktop · светлая",
                  "x": 0,
                  "y": 0,
                  "width": 1280,
                  "height": 824,
                  "layout": "none",
                  "children": [
                    {
                      "id": "g-tc-run-lcap",
                      "type": "text",
                      "content": "Desktop · светлая",
                      "fill": "$hb:colors.textSecondary",
                      "fontFamily": "$hb:typography.family",
                      "fontSize": "$hb:typography.label.size",
                      "lineHeight": "$hb:typography.label.lineHeight",
                      "fontWeight": "$hb:typography.label.weight",
                      "x": 0,
                      "y": 0
                    },
                    {
                      "id": "tc-run",
                      "type": "frame",
                      "name": "Test cases / Start · Run / Desktop",
                      "context": "Мини-апп service-as-ui: один web-узел карточки харнесса testcases (только Desktop), показан в области контента студии; сайдбар окна — хост. Шапка edge-to-edge, поверх справа кнопка «развернуть» хоста (--hb-overlay-width/height). Тема и размеры — токены --hb-*. Данные читаются из файлов репозитория, запись — только через агента. Граница 720: список и панель — в один столбец, вкладки переносятся. Раздел «Прогон»: `progress` + `card` с шагами. Кнопки шага — call record_step (запись в data харнесса, не в репозиторий; durable-запись обновляет карточку). Комментарий — textField (state), уходит в record_step. «Сохранить прогон в репозиторий» и «Поручить агенту разобраться» — prompt-кнопки (submit:false): агент пишет testcases/runs/*.yaml и разбирает провал. Данные прогона ограничены 256 КБ data харнесса.",
                      "reusable": true,
                      "x": 0,
                      "y": 24,
                      "width": 1280,
                      "height": 800,
                      "layout": "none",
                      "theme": {
                        "hb:mode": "light",
                        "hb:host": "desktop"
                      },
                      "fill": "$hb:surfaces.backdrop",
                      "clip": true,
                      "stroke": "$hb:surfaces.outline",
                      "strokeWidth": 2,
                      "strokeAlignment": "outer",
                      "children": [
                        {
                          "id": "tc-run-sb-studio-conversation-desktop-sb",
