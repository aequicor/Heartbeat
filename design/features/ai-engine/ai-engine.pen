                  "id": "light-eng-builtin-continue",
                  "x": 536,
                  "y": 456,
                  "name": "HbButton / Primary / Regular",
                  "context": "Действие применяется только после явного выбора. Enter/Space активируют, Tab перемещает фокус.\nВстроенное исполнение не означает наличие авторизации или готовой модели. Установку, путь к CLI и обновление бинаря здесь не показываем. Коннектор объявляет поддерживаемые способы доступа.",
                  "width": 105,
                  "height": 32,
                  "fill": "$hb:colors.primary",
                  "cornerRadius": "$hb:dimensions.controlCornerRadius",
                  "layout": "none",
                  "children": [
                    {
                      "type": "text",
                      "id": "light-eng-builtin-continue-hb-button-primary-label",
                      "x": 12,
                      "y": 7,
                      "fill": "$hb:colors.onPrimary",
