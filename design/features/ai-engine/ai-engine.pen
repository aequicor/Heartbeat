                      "type": "frame",
                      "id": "DixPq",
                      "x": 196,
                      "y": 31,
                      "name": "Комментарий 2",
                      "context": "Пояснение к статусу движка; аннотация макета, не элемент приложения.",
                      "width": 20,
                      "height": 20,
                      "fill": "$hb:annotation.accent",
                      "cornerRadius": 4,
