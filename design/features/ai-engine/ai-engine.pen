        {
          "type": "frame",
          "id": "BiRKN",
          "x": 0,
          "y": 32256,
          "name": "10 · Изменившийся runtime и чтение истории",
          "theme": {
            "hb:mode": "dark",
            "hb:host": "desktop"
          },
          "width": 5504,
          "height": 3584,
          "layout": "none",
          "children": [
            {
              "type": "text",
              "id": "gVepm",
              "x": 0,
              "y": 0,
              "name": "Восстановление runtime и истории",
              "fill": "$hb:colors.textPrimary",
              "content": "10 · Изменившийся runtime и чтение истории",
              "lineHeight": "$hb:typography.display.lineHeight",
              "fontFamily": "$hb:typography.family",
              "fontSize": "$hb:typography.display.size",
              "fontWeight": "$hb:typography.display.weight"
            },
            {
              "type": "frame",
              "id": "BBKcC",
              "x": 0,
              "y": 64,
              "name": "Локальная установка изменилась / Desktop",
              "context": "Desktop-first review prototype. Windows/macOS/Linux: 1280×800. Tablet/Phone follow after Desktop approval. Фиксированный каркас хоста; контент прокручивается с auto-hide scrollbar. ≥1200: постоянные панели; 720–1199: список становится разделом; <720: drawer. Все слои отсоединены и редактируемы. Модели, аккаунты, версии и результаты в макете демонстрационные; реальные данные и возможности объявляет коннектор. Анимация: NavTransition.Default; reduced motion — мгновенно. Без черновика мастера между открытиями; выполненные установка/подключение сохраняются. Ошибка и неполная проверка не удаляют сохранённый выбор; предупреждение показано у модели. История и привязки старых чатов остаются. Исходные параметры нового чата берутся из последнего начатого рабочего чата: точная связка и применимые настройки. Выбор в панели и проверочный запрос не меняют их. В текущем проекте проверяется применимость; при недоступности требуется явный выбор без fallback. Предпочтение в файле проекта не переписывается: показывается недоступность. История и binding старой сессии сохраняются. 1. При изменении файла по тому же пути заново проверяются fingerprint, версия, происхождение и протокол. Прежнее состояние Verified не переносится на новый бинарь. Пока безопасный контракт неизвестен, допускается только ограниченный probe; вход и рабочий запрос не запускаются. Автоматического fallback нет. StateKey=runtime-changed;Theme=light",
              "theme": {
                "hb:mode": "light",
                "hb:host": "desktop"
              },
              "clip": true,
              "width": 1280,
              "height": 800,
              "fill": "$hb:surfaces.backdrop",
