              "id": "flow-2-2-chat-picker-menu",
              "x": 392,
              "y": 210,
              "name": "Общий выбор вариантов",
              "context": "\nЕдиный список готовых связок, а не последовательный выбор движка и модели. Два одинаковых названия модели различаются движком/подключением. Поиск и Tab/стрелки; Enter выбирает, Esc закрывает. Параметры последнего начатого чата и предпочтение текущего проекта — разные источники; применённые различия показываются при начале сессии.",
              "width": 760,
              "height": 344,
              "fill": "$hb:surfaces.composer",
              "cornerRadius": "$hb:shapes.medium",
              "stroke": "$hb:surfaces.outline",
              "strokeWidth": 1,
              "layout": "none"
            },
