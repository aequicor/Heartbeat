        {
          "type": "text",
          "id": "rGeO8",
          "x": 0,
          "y": 11620,
          "name": "Путь доступа · Подписка и совместимый сервер",
          "fill": "$hb:colors.textSecondary",
          "textGrowth": "fixed-width",
          "width": 13800,
          "content": "Подписка Pi → ключ выбранного тарифного плана",
          "lineHeight": "$hb:typography.caption.lineHeight",
          "fontFamily": "$hb:typography.family",
