              "context": "trigger: Назад → готовые настройки провайдеров, в том же шаге Доступ. Возврат не создаёт подключение и не запускает запрос. Незавершённый ввод удаляется при закрытии мастера.",
              "width": 240,
              "height": 28,
              "cornerRadius": "$hb:dimensions.controlCornerRadius",
              "layout": "none",
              "children": [
                {
                  "id": "ZHyJx",
                  "type": "ref",
