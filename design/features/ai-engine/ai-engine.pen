                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "eqUao",
                  "x": 984,
                  "y": 226,
                  "name": "Удалить установку",
                  "context": "trigger: Удалить установку → модальное подтверждение с Отмена и Удалить установку. Первое нажатие ничего не удаляет. Модальное подтверждение удаления поверх текущего обзора. Фон недоступен вводу; начальный фокус на Отмена, Tab циклически внутри окна. Esc, Отмена и клик по фону закрывают без удаления, возвращая фокус инициатору. Удаление начинается только явной кнопкой внутри диалога. Перед подтверждением повторно проверить отсутствие активного хода и владение установкой. Активный ход не прерывается: кнопка подтверждения недоступна с причиной. Во время принятого удаления повторная отправка запрещена; ошибка сохраняет диалог и показывает причину, без ложного успеха. Подключения, профильная конфигурация и история не удаляются.",
                  "width": 156,
                  "height": 32,
                  "fill": "$hb:colors.error",
                  "cornerRadius": "$hb:dimensions.controlCornerRadius",
                  "layout": "none",
                  "children": [
                    {
                      "type": "text",
                      "id": "nF8mE",
                      "x": 12,
                      "y": 7,
                      "fill": "$hb:colors.onError",
                      "content": "Удалить установку",
                      "lineHeight": "$hb:typography.label.lineHeight",
                      "fontFamily": "$hb:typography.family",
                      "fontSize": "$hb:typography.label.size",
                      "fontWeight": "500"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "LUetO",
                  "x": 1112,
                  "y": 20,
                  "name": "Включение движка · включён",
                  "context": "Рубильник управляет isUserEnabled движка в текущем профиле. Включение и выключение доступны в одном месте. Выключение запрещает новые запросы, не удаляет установку, подключения и историю и не прерывает принятый ход. Включение не доказывает совместимость, авторизацию или готовность модели; необходимые проверки выполняются отдельно. Другие причины блокировки (платформа, флаги) не снимаются рубильником. Tab — фокус, Space — изменение; доступное имя: Включить движок Pi. transition: состояние обзора без навигации, 120ms, standard; reduced motion — мгновенно.",
                  "width": 136,
                  "height": 32,
                  "layout": "none",
                  "children": [
                    {
                      "type": "text",
                      "id": "vv5ll",
                      "x": 0,
                      "y": 7,
                      "fill": "$hb:colors.textPrimary",
                      "content": "Включён",
