                      "fontSize": "$hb:typography.label.size",
                      "fontWeight": "500"
                    },
                    {
                      "type": "frame",
                      "id": "h156O",
                      "x": 108,
                      "y": 8,
                      "name": "HbSwitch / On",
                      "context": "Рубильник управляет isUserEnabled движка в текущем профиле. Включение и выключение доступны в одном месте. Выключение запрещает новые запросы, не удаляет установку, подключения и историю и не прерывает принятый ход. Включение не доказывает совместимость, авторизацию или готовность модели; необходимые проверки выполняются отдельно. Другие причины блокировки (платформа, флаги) не снимаются рубильником. Tab — фокус, Space — изменение; доступное имя: Включить движок Pi. transition: состояние обзора без навигации, 120ms, standard; reduced motion — мгновенно.",
                      "width": 28,
                      "height": 16,
                      "fill": "$hb:colors.brand",
                      "cornerRadius": 8,
                      "layout": "none",
                      "children": [
                        {
                          "type": "ellipse",
                          "id": "p2mRx",
                          "x": 14,
                          "y": 2,
                          "fill": "$hb:colors.onBrand",
                          "width": 12,
                          "height": 12
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "id": "dark-test-passed-caption",
              "x": 4128,
              "y": 1830,
              "fill": "$hb:colors.textSecondary",
              "content": "Модель с замечаниями · i открывает подробности",
              "lineHeight": "$hb:typography.caption.lineHeight",
              "fontFamily": "$hb:typography.family",
              "fontSize": "$hb:typography.caption.size",
              "fontWeight": "$hb:typography.caption.weight"
            },
            {
              "type": "note",
              "id": "dark-test-passed-note-1",
              "x": 4128,
              "y": 2688,
              "name": "Комментарий 1 · Проверка / Успех / Desktop",
              "width": 1280,
              "height": 219,
              "content": "1. Короткая синхронная проверка после Подключить / Сохранить: реальный запрос и непустой ответ; простые пробы точности и признаков фишинга. Цель — несколько секунд, UX-бюджет ожидания всей операции 5 секунд. Пока идёт проверка, кнопка Подключение… / Сохранение… не допускает повтора. Затем возврат в обзор. При успехе никаких отчётов или отметок проверки. При замечании/ошибке/Unknown модель получает жёлтую строку и кнопку i с подробностями в HbDialog; использование не блокируется. При истечении бюджета сохранить выбор и показать неполную проверку, не успех."
            }
          ]
