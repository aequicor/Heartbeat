                "hb:mode": "light",
                "hb:host": "desktop"
              },
              "clip": true,
              "width": 1280,
              "height": 800,
              "fill": "$hb:surfaces.backdrop",
              "stroke": "$hb:surfaces.outline",
              "strokeWidth": 2,
