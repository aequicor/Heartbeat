                      "width": 18,
                      "height": 18,
                      "stroke": "$hb:surfaces.onSelected",
                      "strokeWidth": 1.26,
                      "x": 8,
                      "y": 12
                    },
                    {
                      "type": "text",
                      "id": "X1gG5",
                      "x": 38,
