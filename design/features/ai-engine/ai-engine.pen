                {
                  "type": "frame",
                  "id": "light-update-external",
                  "x": 536,
                  "y": 530,
                  "name": "HbButton / Secondary / Regular",
                  "context": "Действие применяется только после явного выбора. Enter/Space активируют, Tab перемещает фокус.",
                  "width": 213,
                  "height": 32,
                  "fill": "$hb:colors.buttonFill",
                  "cornerRadius": "$hb:dimensions.controlCornerRadius",
                  "layout": "none",
                  "children": [
                    {
                      "type": "text",
