          "layout": "none",
          "children": [
            {
              "type": "text",
              "id": "L0DbsY",
              "x": 0,
              "y": 0,
              "name": "Локальная проверка и ошибка доступа",
              "fill": "$hb:colors.textPrimary",
              "content": "09 · Локальная проверка и ошибка доступа",
              "lineHeight": "$hb:typography.display.lineHeight",
              "fontFamily": "$hb:typography.family",
