                {
                  "type": "frame",
                  "id": "R501C7",
                  "x": 536,
                  "y": 404,
                  "name": "HbTextField / API-ключ",
                  "context": "Поле API-ключ. Enter не обходит проверку обязательных полей. Черновик не сохраняется при закрытии; секреты после подтверждения хранятся только в vault профиля и не попадают в проект или логи.",
                  "width": 712,
                  "height": 32,
                  "fill": "$hb:colors.inputFill",
                  "cornerRadius": "$hb:dimensions.fieldCornerRadius",
                  "layout": "none",
                  "children": [
                    {
                      "type": "text",
                      "id": "EMmpi",
                      "x": 10,
                      "y": 7,
                      "fill": "$hb:colors.textSecondary",
                      "textGrowth": "fixed-width",
                      "width": 650,
                      "content": "Введите API-ключ",
                      "lineHeight": "$hb:typography.label.lineHeight",
