                      "x": 38,
                      "y": 36,
                      "fill": "$hb:colors.textPrimary",
                      "textGrowth": "fixed-width",
                      "width": 710,
                      "content": "История сохранена. Выберите поддерживаемый способ продолжения.",
                      "lineHeight": "$hb:typography.caption.lineHeight",
                      "fontFamily": "$hb:typography.family",
