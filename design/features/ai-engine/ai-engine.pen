                {
                  "type": "frame",
                  "id": "dark-test-required-run",
                  "x": 392,
                  "y": 416,
                  "name": "HbButton / Primary / Regular",
                  "context": "Действие применяется только после явного выбора. Enter/Space активируют, Tab перемещает фокус.\nПроверка обязательна перед первым рабочим чатом выбранной связки и запускается явным действием с предупреждением о квоте. Результат не переносится на другой аккаунт/модель. Успех подтверждает обращение к модели, а не поддержку всех инструментов проекта.",
                  "width": 244,
                  "height": 32,
                  "fill": "$hb:colors.primary",
                  "cornerRadius": "$hb:dimensions.controlCornerRadius",
