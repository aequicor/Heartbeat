                },
                {
                  "type": "frame",
                  "id": "light-setup-browser-browser",
                  "x": 536,
                  "y": 302,
                  "name": "HbButton / Primary / Regular",
                  "context": "Действие применяется только после явного выбора. Enter/Space активируют, Tab перемещает фокус.\nБраузерный вход принадлежит профилю. Закрытие панели не выдаётся за отмену операции; кнопка отменяет только эту операцию. Для источника «Приложение» runtime выбирается отдельно и влияет на все подключения движка.",
                  "width": 190,
                  "height": 32,
                  "fill": "$hb:colors.primary",
