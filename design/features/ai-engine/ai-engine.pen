                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "light-compat-incompatible-engine-0-sub",
                      "x": 38,
                      "y": 52,
                      "fill": "$hb:colors.textSecondary",
                      "textGrowth": "fixed-width",
                      "width": 164,
                      "content": "Несовместимая версия",
                      "lineHeight": "$hb:typography.caption.lineHeight",
