                      "lineHeight": "$hb:typography.label.lineHeight",
                      "fontFamily": "$hb:typography.family",
                      "fontSize": "$hb:typography.label.size",
                      "fontWeight": "500"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "light-setup-progress-annotation-1",
                  "x": 711,
                  "y": 420,
                  "name": "Комментарий 1",
                  "theme": {
                    "hb:mode": "light",
