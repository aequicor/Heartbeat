            },
            {
              "type": "text",
              "id": "LZ7Pi",
              "x": 0,
              "y": 38,
              "fill": "$hb:colors.textSecondary",
              "content": "Светлая · Доступ Pi · Способы подключения",
              "lineHeight": "$hb:typography.caption.lineHeight",
              "fontFamily": "$hb:typography.family",
              "fontSize": "$hb:typography.caption.size",
              "fontWeight": "$hb:typography.caption.weight"
            },
            {
              "type": "frame",
              "id": "C08tbX",
              "x": 0,
              "y": 64,
              "name": "Доступ Pi · Способы подключения / Desktop",
              "context": "Desktop-first review prototype. Windows/macOS/Linux: 1280×800. Tablet/Phone follow after Desktop approval. Фиксированный каркас хоста; контент прокручивается с auto-hide scrollbar. ≥1200: постоянные панели; 720–1199: список становится разделом; <720: drawer. Все слои отсоединены и редактируемы. Модели, аккаунты, версии и результаты в макете демонстрационные; реальные данные и возможности объявляет коннектор. Анимация: NavTransition.Default; reduced motion — мгновенно. Без черновика мастера между открытиями; выполненные установка/подключение сохраняются. Ошибка и неполная проверка не удаляют сохранённый выбор; предупреждение показано у модели. История и привязки старых чатов остаются. Исходные параметры нового чата берутся из последнего начатого рабочего чата: точная связка и применимые настройки. Выбор в панели и проверочный запрос не меняют их. В текущем проекте проверяется применимость; при недоступности требуется явный выбор без fallback. Предпочтение в файле проекта не переписывается: показывается недоступность. История и binding старой сессии сохраняются. StateKey=access-choice;Theme=light. Способы доступа и их пресеты определяются метаданными коннектора. Это проектируемый единый UX, не утверждение об универсальном OAuth или уже реализованной новой навигации.",
              "theme": {
                "hb:mode": "light",
                "hb:host": "desktop"
              },
              "clip": true,
              "width": 1280,
              "height": 800,
