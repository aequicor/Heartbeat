        {
          "type": "frame",
          "id": "group-2",
          "x": 0,
          "y": 7168,
          "name": "03 · Вход и каталог моделей",
          "theme": {
            "hb:mode": "dark",
            "hb:host": "desktop"
          },
          "width": 5504,
          "height": 3584,
          "layout": "none",
          "children": [
            {
              "type": "text",
              "id": "group-title-2",
              "x": 0,
              "y": 0,
              "fill": "$hb:colors.textPrimary",
