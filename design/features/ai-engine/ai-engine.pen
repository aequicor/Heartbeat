                {
                  "type": "frame",
                  "id": "light-route-lost-status",
                  "x": 392,
                  "y": 170,
                  "name": "HbBanner / Error",
                  "context": "\nУбирается только подтверждённо недоступная сохранённая связка. Неизвестность/сбой discovery её не удаляют. История и route старой сессии сохраняются; смена движка — явный handoff, принятый промпт не повторяется. Недоступное предпочтение проекта не переписывается. Отступы баннера: 12 со всех сторон, иконка18 и gap8 до текста; между заголовком и пояснением6. Высота по измеренным строкам текста, не фиксированная.",
                  "width": 760,
                  "height": 80,
                  "fill": "$hb:colors.warningContainer",
                  "cornerRadius": "$hb:shapes.medium",
                  "layout": "none",
                  "children": [
                    {
                      "id": "light-route-lost-status-hb-banner-error-icon",
                      "type": "ref",
                      "ref": "hb:hb-icon-info",
                      "width": 18,
                      "height": 18,
                      "stroke": "$hb:colors.textSecondary",
                      "strokeWidth": 1.26,
                      "x": 12,
                      "y": 12
                    },
                    {
                      "type": "text",
                      "id": "light-route-lost-status-hb-banner-error-message",
                      "x": 38,
                      "y": 12,
                      "fill": "$hb:colors.textPrimary",
                      "textGrowth": "fixed-width",
                      "width": 710,
                      "content": "Модель больше не доступна этому подключению",
                      "lineHeight": "$hb:typography.label.lineHeight",
                      "fontFamily": "$hb:typography.family",
                      "fontSize": "$hb:typography.label.size",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "light-route-lost-status-detail",
                      "x": 38,
                      "y": 36,
                      "fill": "$hb:colors.textPrimary",
                      "textGrowth": "fixed-width",
                      "width": 710,
                      "content": "Недоступность подтверждена каталогом. Модель убрана из сохранённого выбора. Установка, подключение и история сохранены.",
                      "lineHeight": "$hb:typography.caption.lineHeight",
                      "fontFamily": "$hb:typography.family",
                      "fontSize": "$hb:typography.caption.size",
                      "fontWeight": "$hb:typography.caption.weight"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "light-route-lost-alt-one",
                  "x": 392,
                  "y": 286,
                  "name": "HbNavigationItem",
                  "context": "Строка меняет выбор внутри текущей области. Hover/selected — тихая заливка. Полная подпись доступна при фокусе; смена выбора не отправляет запрос.",
                  "width": 760,
                  "height": 60,
                  "cornerRadius": "$hb:dimensions.controlCornerRadius",
                  "layout": "none",
                  "children": [
                    {
                      "id": "light-route-lost-alt-one-hb-nav-item-icon",
                      "type": "ref",
                      "ref": "hb:hb-icon-user",
                      "width": 18,
                      "height": 18,
                      "stroke": "$hb:colors.textSecondary",
                      "strokeWidth": 1.26,
                      "x": 8,
                      "y": 12
                    },
                    {
                      "type": "text",
                      "id": "light-route-lost-alt-one-hb-nav-item-label",
                      "x": 38,
