                  "id": "FrCvG",
                  "x": 272,
                  "y": 108,
                  "name": "HbNavigationItem / Selected",
                  "context": "Строка движка содержит только имя и отдельный статус. Подзаголовка нет. Ошибки и следующий шаг показаны в панели движка.",
                  "width": 224,
                  "height": 60,
                  "fill": "$hb:surfaces.selected",
