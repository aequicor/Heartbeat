{
 "version": "2.21",
 "imports": {
  "hb": "../../system/heartbeat.lib.pen"
 },
 "children": [
  {
   "id": "section-components",
   "type": "frame",
   "name": "Components",
   "x": 0,
   "y": -1000,
   "layout": "horizontal",
   "gap": 80,
   "padding": 40,
   "children": [
    {
     "id": "settings-sidebar",
     "type": "frame",
     "name": "Settings / Sidebar · dimensions.sidebarWidth",
     "width": 264,
     "height": 800,
     "layout": "vertical",
     "fill": "$hb:surfaces.sidebar",
     "children": [
      {
       "id": "settings-sidebar-header",
       "type": "frame",
       "width": "fill_container",
       "height": 44,
       "padding": [
        0,
        8,
        0,
        4
       ],
       "alignItems": "center",
       "children": [
        {
         "id": "settings-sidebar-lights",
         "type": "ref",
         "ref": "hb:window-traffic-lights"
        },
        {
         "id": "settings-sidebar-title",
         "type": "text",
         "content": "Настройки",
         "fill": "$hb:colors.textSecondary",
         "fontSize": "$hb:typography.label.size",
         "lineHeight": "$hb:typography.label.lineHeight",
         "fontWeight": "$hb:typography.label.weight"
        }
       ],
       "name": "settings-sidebar-header · dimensions.headerHeight"
      },
      {
       "id": "settings-sidebar-list",
       "type": "frame",
       "width": "fill_container",
       "height": "fill_container",
       "layout": "vertical",
       "padding": [
        6,
        8
       ],
       "children": [
        {
         "id": "settings-item-0",
         "type": "frame",
         "name": "Модели и движки",
         "width": "fill_container",
         "height": 28,
         "padding": [
          0,
          4,
          0,
          8
         ],
         "gap": "$hb:spacing.l",
         "alignItems": "center",
         "cornerRadius": "$hb:dimensions.controlCornerRadius",
         "fill": "$hb:surfaces.selected",
         "children": [
          {
           "id": "settings-item-0-icon",
           "type": "icon",
           "library": "lucide",
           "icon": "layers",
           "width": 18,
           "height": 18,
           "fill": "$hb:surfaces.onSelected"
          },
          {
           "id": "settings-item-0-label",
           "type": "text",
           "content": "Модели и движки",
           "fill": "$hb:surfaces.onSelected",
           "fontSize": "$hb:typography.label.size",
           "lineHeight": "$hb:typography.label.lineHeight",
           "fontWeight": "$hb:typography.label.weight",
           "width": "fill_container"
          }
         ]
        },
        {
         "id": "settings-item-1",
         "type": "frame",
