  {
   "id": "section-screens",
   "type": "frame",
   "name": "Screens",
   "x": 0,
   "y": 0,
   "layout": "horizontal",
   "gap": 80,
   "padding": 40,
   "children": [
    {
     "id": "wizard-engine",
     "type": "frame",
     "name": "Wizard / Engine",
     "reusable": true,
     "width": 1280,
     "height": 800,
     "layout": "horizontal",
     "theme": {
      "hb:mode": "light",
      "hb:host": "desktop"
     },
     "fill": "$hb:surfaces.backdrop",
     "clip": true,
     "children": [
      {
       "id": "wizard-engine-sidebar",
       "type": "ref",
       "ref": "settings-sidebar",
       "height": "fill_container"
      },
      {
       "id": "wizard-engine-content",
       "type": "frame",
       "name": "Content",
       "width": "fill_container",
       "height": "fill_container",
       "justifyContent": "center",
       "padding": "$hb:spacing.xl",
       "children": [
        {
         "id": "wizard-engine-column",
         "type": "frame",
         "name": "Wizard · dimensions.settingsMaxWidth",
         "width": 720,
         "height": "fill_container",
         "layout": "vertical",
         "gap": "$hb:spacing.l",
         "children": [
          {
           "id": "wizard-engine-header",
           "type": "frame",
           "width": "fill_container",
           "layout": "vertical",
           "gap": "$hb:spacing.xxs",
           "children": [
            {
             "id": "wizard-engine-title",
             "type": "text",
             "content": "Подключение движка",
             "fill": "$hb:colors.textPrimary",
             "fontSize": "$hb:typography.title.size",
             "lineHeight": "$hb:typography.title.lineHeight",
             "fontWeight": "600"
            },
            {
             "id": "wizard-engine-step",
             "type": "text",
             "content": "Шаг 1 из 3 · Движок",
             "fill": "$hb:colors.textSecondary",
             "fontSize": "$hb:typography.caption.size",
             "lineHeight": "$hb:typography.caption.lineHeight",
             "fontWeight": "$hb:typography.caption.weight"
            }
           ]
          },
          {
           "id": "wizard-engine-body",
           "type": "frame",
           "width": "fill_container",
           "height": "fill_container",
           "layout": "vertical",
           "gap": "$hb:spacing.xl",
           "children": [
            {
             "id": "wizard-engine-intro",
             "type": "text",
             "content": "Выберите движок, который будет выполнять сессии.",
             "fill": "$hb:colors.textSecondary",
             "fontSize": "$hb:typography.label.size",
             "lineHeight": "$hb:typography.label.lineHeight",
             "fontWeight": "$hb:typography.label.weight",
             "width": "fill_container",
             "textGrowth": "fixed-width"
            },
            {
             "id": "wizard-engine-list",
             "type": "frame",
             "width": "fill_container",
             "layout": "vertical",
             "children": [
