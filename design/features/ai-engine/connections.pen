             "ref": "hb:hb-button-primary",
             "descendants": {
              "hb:hb-button-primary-label": {
               "content": "Подключить"
              }
             }
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "id": "wizard-models",
     "type": "frame",
     "name": "Wizard / Models",
     "reusable": true,
     "width": 1280,
     "height": 800,
     "layout": "horizontal",
     "theme": {
      "hb:mode": "light",
      "hb:host": "desktop"
     },
     "fill": "$hb:surfaces.backdrop",
     "clip": true,
     "children": [
      {
       "id": "wizard-models-sidebar",
