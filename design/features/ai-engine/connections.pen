                   "content": "Подключений: 1",
                   "fill": "$hb:colors.textSecondary",
                   "fontSize": "$hb:typography.caption.size",
                   "lineHeight": "$hb:typography.caption.lineHeight",
                   "fontWeight": "$hb:typography.caption.weight"
                  }
                 ]
                },
                {
                 "id": "wizard-engine-pi-badge",
                 "type": "ref",
                 "ref": "hb:hb-badge-success",
                 "descendants": {
                  "hb:hb-badge-success-label": {
                   "content": "Установлен"
                  }
                 }
                },
                {
                 "id": "wizard-engine-pi-chevron",
                 "type": "icon",
