{
 "version": "2.21",
 "imports": {
  "hb": "../../system/heartbeat.lib.pen"
 },
 "children": [
  {
   "id": "section-screens",
   "type": "frame",
   "name": "Экраны",
   "layout": "none",
   "theme": {
    "hb:mode": "dark",
    "hb:host": "desktop"
   },
   "children": [
    {
     "id": "g-wizard-engine",
     "type": "frame",
     "name": "Wizard / Engine — шаг 1: выбор движка",
     "layout": "none",
     "children": [
      {
       "id": "g-wizard-engine-title",
       "type": "text",
       "content": "Wizard / Engine — шаг 1: выбор движка",
       "fill": "$hb:colors.textPrimary",
       "fontFamily": "$hb:typography.family",
       "fontSize": "$hb:typography.title.size",
       "lineHeight": "$hb:typography.title.lineHeight",
       "fontWeight": "600",
       "x": 0,
       "y": 0
      },
      {
       "id": "g-wizard-engine-light",
       "type": "frame",
       "name": "Светлая тема",
       "children": [
        {
