                   "fontSize": "$hb:typography.caption.size",
                   "lineHeight": "$hb:typography.caption.lineHeight",
                   "fontWeight": "$hb:typography.caption.weight",
                   "width": "fill_container",
                   "textGrowth": "fixed-width"
                  }
                 ]
                },
                {
                 "id": "wizard-auth-error-error",
                 "type": "ref",
                 "ref": "hb:hb-banner-error"
                },
                {
                 "id": "wizard-auth-error-get-key",
                 "type": "ref",
                 "ref": "hb:hb-button-ghost-small",
                 "descendants": {
                  "hb:hb-button-ghost-small-label": {
                   "content": "Получить API-ключ"
                  }
                 }
                },
                {
                 "id": "wizard-auth-error-address",
                 "type": "frame",
                 "width": "fill_container",
                 "layout": "vertical",
                 "gap": "$hb:spacing.xs",
                 "children": [
                  {
                   "id": "wizard-auth-error-address-label",
                   "type": "text",
                   "content": "Адрес API",
                   "fill": "$hb:colors.textPrimary",
                   "fontSize": "$hb:typography.label.size",
                   "lineHeight": "$hb:typography.label.lineHeight",
                   "fontWeight": "$hb:typography.label.weight"
                  },
                  {
                   "id": "wizard-auth-error-address-input",
                   "type": "ref",
                   "ref": "hb:hb-text-field",
                   "descendants": {
                    "hb:hb-text-field-value": {
                     "content": "https://api.anthropic.com",
                     "fill": "$hb:colors.textSecondary"
                    }
                   }
                  },
                  {
                   "id": "wizard-auth-error-address-hint",
                   "type": "text",
                   "content": "Адрес фиксирован для этого провайдера.",
                   "fill": "$hb:colors.textSecondary",
                   "fontSize": "$hb:typography.caption.size",
                   "lineHeight": "$hb:typography.caption.lineHeight",
                   "fontWeight": "$hb:typography.caption.weight",
                   "width": "fill_container",
                   "textGrowth": "fixed-width"
                  }
                 ]
                },
                {
                 "id": "wizard-auth-error-name",
                 "type": "frame",
                 "width": "fill_container",
                 "layout": "vertical",
                 "gap": "$hb:spacing.xs",
                 "children": [
                  {
                   "id": "wizard-auth-error-name-label",
                   "type": "text",
                   "content": "Название подключения",
                   "fill": "$hb:colors.textPrimary",
                   "fontSize": "$hb:typography.label.size",
                   "lineHeight": "$hb:typography.label.lineHeight",
                   "fontWeight": "$hb:typography.label.weight"
                  },
                  {
                   "id": "wizard-auth-error-name-input",
                   "type": "ref",
                   "ref": "hb:hb-text-field",
                   "descendants": {
                    "hb:hb-text-field-value": {
                     "content": "Anthropic",
                     "fill": "$hb:colors.textPrimary"
                    }
                   }
                  }
                 ]
                }
               ]
              }
             ]
            }
           ]
          },
          {
           "id": "wizard-auth-error-footer",
           "type": "frame",
           "name": "Footer",
           "width": "fill_container",
           "gap": "$hb:spacing.s",
           "alignItems": "center",
           "children": [
            {
