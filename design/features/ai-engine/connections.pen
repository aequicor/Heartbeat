                 "fontSize": "$hb:typography.caption.size",
                 "lineHeight": "$hb:typography.caption.lineHeight",
                 "fontWeight": "$hb:typography.caption.weight"
                }
               ]
              },
              {
               "id": "wizard-auth-error-form",
               "type": "frame",
               "width": "fill_container",
               "layout": "vertical",
               "gap": "$hb:spacing.s",
               "padding": [
                0,
                8
               ],
               "children": [
                {
                 "id": "wizard-auth-error-key",
                 "type": "frame",
                 "width": "fill_container",
                 "layout": "vertical",
                 "gap": "$hb:spacing.xs",
                 "children": [
                  {
                   "id": "wizard-auth-error-key-label",
                   "type": "text",
                   "content": "API-ключ",
                   "fill": "$hb:colors.textPrimary",
                   "fontSize": "$hb:typography.label.size",
                   "lineHeight": "$hb:typography.label.lineHeight",
                   "fontWeight": "$hb:typography.label.weight"
                  },
                  {
                   "id": "wizard-auth-error-key-input",
                   "type": "ref",
                   "ref": "hb:hb-text-field",
                   "descendants": {
                    "hb:hb-text-field-value": {
                     "content": "Вставьте ключ",
                     "fill": "$hb:colors.textSecondary"
                    }
                   }
                  },
                  {
                   "id": "wizard-auth-error-key-hint",
                   "type": "text",
                   "content": "Ключ хранится в защищённом хранилище профиля.",
