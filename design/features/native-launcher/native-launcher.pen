{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "section-screens",
      "x": 0,
      "y": 0,
      "name": "Экраны",
      "theme": {
        "hb:mode": "dark",
        "hb:host": "desktop"
      },
      "width": 4360,
      "height": 1900,
      "layout": "none",
      "children": [
        {
          "type": "frame",
          "id": "g-launcher-first-run",
          "x": 0,
          "y": 0,
          "name": "Launcher / First run — первый запуск",
          "width": 1280,
          "height": 1870,
          "layout": "none",
          "children": [
            {
              "type": "text",
              "id": "g-launcher-first-run-title",
              "x": 0,
              "y": 0,
              "name": "Название группы",
              "fill": "$hb:colors.textPrimary",
              "content": "Launcher / First run — первый запуск",
              "lineHeight": "$hb:typography.title.lineHeight",
              "fontFamily": "$hb:typography.family",
              "fontSize": "$hb:typography.title.size",
              "fontWeight": "600"
            },
            {
              "type": "frame",
              "id": "g-launcher-first-run-light",
              "x": 0,
              "y": 32,
              "name": "Светлая тема",
              "width": 1280,
              "height": 832,
              "layout": "none",
              "children": [
                {
                  "type": "text",
                  "id": "g-launcher-first-run-light-caption",
                  "x": 0,
                  "y": 0,
                  "name": "Подпись",
                  "fill": "$hb:colors.textSecondary",
                  "content": "Desktop · светлая",
                  "lineHeight": "$hb:typography.caption.lineHeight",
                  "fontFamily": "$hb:typography.family",
                  "fontSize": "$hb:typography.caption.size",
                  "fontWeight": "$hb:typography.caption.weight"
                },
                {
                  "type": "frame",
                  "id": "launcher-first-run-light",
                  "x": 0,
                  "y": 32,
                  "name": "Launcher / First run / Desktop",
                  "context": "Только Desktop: нативное окно лончера до старта JVM. Окно открывается сразу при запуске исполняемого файла, в размере основного окна приложения (dimensions.windowWidth × windowHeight). Сворачивание не останавливает загрузку; готовность не разворачивает окно и не крадёт фокус. Закрытие до готовности отменяет запуск. HiDPI и resize — платформенные, native.",
                  "theme": {
                    "hb:mode": "light",
                    "hb:host": "desktop"
                  },
                  "reusable": true,
                  "clip": true,
                  "width": 1280,
                  "height": 800,
                  "fill": "$hb:surfaces.backdrop",
                  "stroke": "$hb:surfaces.outline",
                  "strokeWidth": 2,
                  "strokeAlignment": "outer",
                  "layout": "none",
                  "children": [
                    {
                      "type": "frame",
                      "id": "launcher-first-run-light-titlebar",
                      "x": 0,
                      "y": 0,
                      "name": "Title bar · системный, нативный (высота задаётся ОС)",
                      "width": 1280,
                      "height": 32,
                      "fill": "$hb:surfaces.header",
                      "layout": "none",
                      "children": [
                        {
                          "type": "text",
                          "id": "launcher-first-run-light-titlebar-title",
                          "x": 606,
                          "y": 8,
                          "name": "Заголовок окна",
                          "fill": "$hb:colors.textSecondary",
                          "content": "Heartbeat",
                          "lineHeight": "$hb:typography.label.lineHeight",
                          "fontFamily": "$hb:typography.family",
                          "fontSize": "$hb:typography.label.size",
                          "fontWeight": "500"
                        }
                      ]
                    },
                    {
                      "id": "launcher-first-run-light-logo",
                      "type": "ref",
