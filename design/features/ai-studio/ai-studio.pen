           "height": 18,
           "stroke": "$hb:colors.textSecondary",
           "strokeWidth": 1.26
          }
         }
        }
       ],
       "name": "studio-sidebar-header · dimensions.headerHeight"
      },
      {
       "id": "studio-sidebar-list",
       "type": "frame",
       "width": "fill_container",
       "height": "fill_container",
       "layout": "vertical",
