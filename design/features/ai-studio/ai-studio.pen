{
 "version": "2.21",
 "imports": {
  "hb": "../../system/heartbeat.lib.pen"
 },
 "children": [
  {
   "id": "section-components",
   "type": "frame",
   "name": "Components",
   "x": 0,
   "y": -1000,
   "layout": "horizontal",
   "gap": 80,
   "padding": 40,
   "children": [
    {
     "id": "studio-sidebar",
     "type": "frame",
