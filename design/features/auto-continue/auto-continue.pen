              "fontFamily": "$hb:typography.family",
              "fontSize": "$hb:typography.label.size",
              "fontWeight": "500"
            }
          ]
        }
      ]
    },
    {
      "type": "note",
      "id": "ap2-153",
      "x": 10000,
      "y": 1928,
      "name": "Комментарий 1 · Автопилот / Настройки / Desktop / Dark",
      "width": 900,
      "height": 200,
      "content": "1. Единая страница настроек профиля: сначала многострочный системный промпт, затем объём истории с выпадающим меню, затем переключатели источников контекста. Выбор модели только при включении автопилота в чате. Лимиты, задержки и отдельный редактор инструкций убраны из пользовательского сценария. TextArea имеет ограниченную высоту и собственную вертикальную прокрутку с auto-hide scrollbar, колесо работает над полем, не прокручивая всю страницу до границы поля. Ввод сохраняется с debounce после успешной записи; при ошибке сохраняется черновик, рядом с полем ненавязчивое сообщение с повтором. Служебный формат ответа добавляется отдельно и не показывается как настройка. Объём истории 10 / 20 / 40 последних сообщений; исходная задача и последние указания сохраняются. Если история выключена, выбор объёма недоступен, значение сохраняется. Профильные настройки действуют со следующего ответа; устаревшая генерация отменяется. После согласования Desktop подготовить Phone/Tablet: <1200 сайдбар drawer, <720 колонка по ширине с отступами и кнопка объёма под подписью. Нет неактивных тоглов: задача и текущий запрос передаются всегда, это объяснено подписью."
    },
    {
      "type": "frame",
      "id": "ap2-179",
      "x": 11440,
      "y": 0,
      "name": "Автопилот / Включение в чате / Desktop",
      "context": "Включение автопилота: только две кнопки. «Выбрать текущую» — первичное действие по умолчанию, сразу включает автопилот с текущей связкой движок/подключение/модель этого чата, Enter активирует его. «Выбрать другую» открывает существующий список выбора модели чата, без отдельных полей движка и подключения и без дополнительной кнопки Включить. Выбор доступной строки списка сразу включает автопилот с выбранной связкой для этого чата. Esc сначала закрывает список, затем диалог, без изменения режима. Фокус возвращается на инициирующую кнопку. Состав, порядок, доступность, пояснения и клавиатурная навигация списка полностью переиспользуют выбор модели чата. Недоступная строка не выбирается; полномочия не расширяются. В новом чате доступно до первой задачи: выбор хранится с черновиком, при создании привязывается к id чата. Первая задача сохраняет режим; до неё продолжатель не вызывается и лоадера нет. Изменение модели основного агента не меняет отдельно выбранную модель автопилота. Desktop-first; после согласования адаптации Phone/Tablet. На узком экране кнопки идут столбцом, список заполняет доступную ширину. Кнопки расположены: слева Выбрать другую (список), справа Выбрать текущую (основное действие по умолчанию). Фон модального окна размывается по явному требованию пользователя; окно и раскрытый список не размываются.",
      "theme": {
        "hb:mode": "light",
        "hb:host": "desktop"
      },
