        },
        {
          "type": "text",
          "id": "FHAnU",
          "x": 392,
          "y": 110,
          "name": "Инструкции, по которым автопилот принимает решения",
          "fill": "$hb:colors.textSecondary",
          "textGrowth": "fixed-width",
          "width": 760,
          "content": "Инструкции, по которым автопилот принимает решения и отвечает агенту.",
          "lineHeight": "$hb:typography.label.lineHeight",
          "fontFamily": "$hb:typography.family",
