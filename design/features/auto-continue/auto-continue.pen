          "y": 0,
          "name": "Studio / Sidebar",
          "context": "Сайдбар · Studio / Sidebar Ширина 264, прибит слева. Список сессий прокручивается, панель иконок прибита к низу. При ширине < 720 превращается в drawer.",
          "width": 264,
          "height": 800,
          "fill": "$hb:surfaces.sidebar",
          "layout": "none",
          "children": [
