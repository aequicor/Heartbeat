              "x": 316,
              "y": 112,
              "name": "HbButton / Primary / Regular",
              "context": "Основная кнопка, выбор по умолчанию. Включает автопилот с текущей моделью чата сразу. Если у чата нет доступной модели, недоступна; предложен выбор другой.",
              "width": 260,
              "height": 32,
              "fill": "$hb:colors.primary",
              "cornerRadius": "$hb:dimensions.controlCornerRadius",
              "layout": "none",
              "children": [
