        {
          "type": "frame",
          "id": "dAGmJ",
          "x": 884,
          "y": 400,
          "name": "HbDropdown / Объём истории",
          "context": "trigger click / transition: выпадающее меню вариантов 10 / 20 / 40 сообщений. Текущее значение отмечено галочкой. Выбор сохраняется сразу. Esc закрывает без изменения, фокус возвращается кнопке.",
          "width": 268,
          "height": 32,
          "fill": "$hb:colors.inputFill",
