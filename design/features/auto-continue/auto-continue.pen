      "type": "frame",
      "id": "LBtOI",
      "x": 5600,
      "y": 886,
      "name": "Автопродолжение / Режимы / Desktop / Dark",
      "context": "Предложение дизайна: индикатор в композере и меню выбора режима; пользовательский экран в текущем файле сохраняется отдельно. Выбранный режим различим по тексту и отметке, без зависимости от цвета.",
      "theme": {
        "hb:mode": "dark",
        "hb:host": "desktop"
      },
      "width": 850,
      "height": 450,
      "fill": "$hb:surfaces.backdrop",
