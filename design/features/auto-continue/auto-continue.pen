                {
                  "type": "frame",
                  "id": "ap2-1306",
                  "x": 128,
                  "y": 581,
                  "name": "Автопилот / Самостоятельное решение",
                  "context": "Подготовка решения показывает лоадер. Продолжатель получает точное действие, рабочий каталог, обоснование и ограничения задачи. Решение проходит через существующий гейт по идентификатору актуального запроса. Разрешение разовое; глобальная настройка безопасности не меняется. Результат помечается «Автопилот». Если полномочий недостаточно — требуется человек.",
                  "width": 760,
                  "height": 40,
                  "fill": "$hb:surfaces.composer",
                  "cornerRadius": 12,
                  "stroke": "$hb:surfaces.outline",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
