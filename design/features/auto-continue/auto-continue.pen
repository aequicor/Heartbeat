          "layout": "none",
          "children": [
            {
              "type": "text",
              "id": "C99MCO",
              "x": 10,
              "y": 7,
              "name": "Выбранный объём истории",
              "fill": "$hb:colors.textPrimary",
              "content": "Последние 20 сообщений",
