            },
            {
              "type": "text",
              "id": "ds-effects-intro",
              "x": 48,
              "y": 104,
              "fill": "$hb:colors.textSecondary",
              "textGrowth": "fixed-width",
              "width": 1104,
              "content": "Затухание текста (HbText, maxLines = 1): однострочный текст, который не поместился, обрезается и гаснет к правому краю на dimensions.textOverflowFade (24) — как в нативных сайдбарах, без многоточия и без выхода за рамки; пока он обрезан, тултип показывает полный текст. В макете — прямоугольник с градиентом effects.fade.<поверхность> → surfaces.<поверхность> поверх обрезанной строки (clip). Фон под градиентом — поверхность строки: sidebar, selected, assistant, composer, header, backdrop. TextOverflow.Ellipsis для однострочного текста запрещён.",
              "lineHeight": "$hb:typography.body.lineHeight",
              "fontFamily": "$hb:typography.family",
              "fontSize": "$hb:typography.body.size",
              "fontWeight": "$hb:typography.body.weight"
            },
