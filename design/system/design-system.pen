        {
          "type": "frame",
          "id": "ds-effects",
          "x": 0,
          "y": 9997,
          "name": "Design system / Effects",
          "context": "Эффекты ДС. Затухание текста: HbText(maxLines = 1) → hbTrailingFade, ширина dimensions.textOverflowFade; тултип с полным текстом при обрезке. Многоточие для однострочного текста запрещено.",
          "theme": {
            "hb:mode": "light",
            "hb:host": "desktop"
          },
          "width": 1200,
          "height": 500,
          "fill": "$hb:surfaces.backdrop",
          "layout": "none",
          "children": [
            {
              "type": "text",
              "id": "ds-effects-title",
