{
 "version": "2.21",
 "imports": {
  "hb": "heartbeat.lib.pen"
 },
 "children": [
  {
   "id": "ds-page",
   "type": "frame",
   "name": "Design system",
   "x": 0,
   "y": 0,
   "layout": "none",
   "children": [
    {
     "id": "ds-intro",
     "type": "frame",
     "name": "Design system / Overview",
     "width": 1200,
     "layout": "none",
     "fill": "$hb:surfaces.backdrop",
     "theme": {
      "hb:mode": "light",
      "hb:host": "desktop"
     },
     "children": [
      {
       "id": "ds-head",
       "type": "frame",
       "width": 1104,
       "layout": "none",
       "children": [
        {
         "id": "ds-head-title",
         "type": "text",
         "content": "Дизайн-система Heartbeat",
         "fill": "$hb:colors.textPrimary",
         "fontFamily": "$hb:typography.family",
         "fontSize": "$hb:typography.display.size",
         "lineHeight": "$hb:typography.display.lineHeight",
         "fontWeight": "600",
         "x": 0,
         "y": 0
        },
        {
         "id": "ds-head-intro",
         "type": "text",
         "content": "Плотный плоский стиль студии: окно edge-to-edge с одним сайдбаром, тихие состояния, режимы вместо экранов. Определения — design/system/heartbeat.lib.pen, правила — .claude/rules/design-system.md, код — design-system:{tokens,components}.",
         "fill": "$hb:colors.textSecondary",
         "fontFamily": "$hb:typography.family",
         "fontSize": "$hb:typography.body.size",
         "lineHeight": "$hb:typography.body.lineHeight",
         "fontWeight": "$hb:typography.body.weight",
         "width": 1104,
         "textGrowth": "fixed-width",
         "x": 0,
         "y": 36
        }
       ],
       "x": 48,
       "y": 48,
       "height": 78
      }
     ],
     "x": 0,
     "y": 0,
     "height": 174
    },
    {
     "id": "ds-colors-row",
     "type": "frame",
     "children": [
      {
       "id": "ds-colors",
