     "alignItems": "center",
     "gap": "$spacing.xs",
     "children": [
      {
       "id": "hb-button-primary-label",
       "type": "text",
       "content": "Подключить",
       "fill": "$colors.onPrimary",
       "fontSize": "$typography.label.size",
       "lineHeight": "$typography.label.lineHeight",
       "fontWeight": "500"
      }
     ],
     "fill": "$colors.primary"
    },
    {
     "id": "hb-button-secondary",
