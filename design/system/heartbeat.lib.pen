       "height": 14,
       "fill": "$surfaces.onComposerPillAccent"
      },
      {
       "id": "hb-composer-accentpill-label",
       "type": "text",
       "content": "medium",
       "fill": "$surfaces.onComposerPillAccent",
       "fontSize": "$typography.label.size",
       "lineHeight": "$typography.label.lineHeight",
       "fontWeight": "$typography.label.weight"
      },
      {
       "id": "hb-composer-accentpill-chevron",
       "type": "icon",
       "library": "lucide",
       "icon": "chevron-down",
       "width": 14,
       "height": 14,
       "fill": "$surfaces.onComposerPillAccent"
      }
     ]
    },
    {
     "id": "hb-composer-send",
     "type": "frame",
     "name": "HbComposer / Send · dimensions.composerActionSize",
     "reusable": true,
