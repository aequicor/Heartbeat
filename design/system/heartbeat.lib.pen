     "id": "hb-composer-pill",
     "type": "frame",
     "name": "HbComposerMenuButton / Pill · dimensions.composerPillHeight",
     "reusable": true,
     "height": 32,
     "padding": [
      4,
      8
     ],
     "gap": "$spacing.xs",
     "alignItems": "center",
     "cornerRadius": "$shapes.small",
     "fill": "$surfaces.composerPill",
     "children": [
      {
       "id": "hb-composer-pill-icon",
       "type": "icon",
       "library": "lucide",
       "icon": "layers",
       "width": 14,
       "height": 14,
       "fill": "$colors.textPrimary"
      },
      {
       "id": "hb-composer-pill-label",
       "type": "text",
       "content": "Sonnet 5.5",
       "fill": "$colors.textPrimary",
       "fontSize": "$typography.label.size",
       "lineHeight": "$typography.label.lineHeight",
       "fontWeight": "$typography.label.weight"
      },
      {
       "id": "hb-composer-pill-chevron",
       "type": "icon",
       "library": "lucide",
       "icon": "chevron-down",
       "width": 14,
       "height": 14,
       "fill": "$colors.textPrimary"
      }
     ]
    },
    {
     "id": "hb-composer-accentpill",
     "type": "frame",
