{
  "version": "2.21",
  "imports": {
    "hb": "heartbeat.lib.pen"
  },
  "children": [
    {
      "id": "dropdown-desktop",
      "type": "frame",
      "name": "HbDropdown / States / Desktop",
      "context": "Выбор одного значения: закрытое поле, раскрытое меню с отметкой текущего значения и недоступное поле. Меню закрывается после выбора или по Esc; стрелки перемещают фокус, Enter выбирает. Длинные подписи затухают к краю. При нехватке места меню прокручивается и открывается в доступную сторону.",
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 400,
      "layout": "none",
      "reusable": true,
      "theme": {
        "hb:mode": "light",
        "hb:host": "desktop"
      },
      "fill": "$hb:surfaces.backdrop",
      "children": [
        {
          "id": "dropdown-heading",
          "type": "text",
          "content": "Выпадающий список",
          "x": 32,
          "y": 24,
          "fill": "$hb:colors.textPrimary",
          "fontFamily": "$hb:typography.family",
          "fontSize": "$hb:typography.label.size",
          "fontWeight": "$hb:typography.label.weight"
        },
        {
          "id": "dropdown-closed-title",
          "type": "text",
          "content": "Закрыт",
          "x": 32,
          "y": 70,
          "fill": "$hb:colors.textSecondary",
          "fontFamily": "$hb:typography.family",
          "fontSize": "$hb:typography.label.size",
          "fontWeight": "$hb:typography.label.weight"
        },
        {
          "id": "dropdown-closed",
          "type": "frame",
          "name": "HbDropdown / Desktop / Closed",
          "x": 32,
          "y": 96,
          "width": 240,
          "height": 32,
          "layout": "none",
          "cornerRadius": "$hb:dimensions.fieldCornerRadius",
          "fill": "$hb:colors.inputFill",
          "children": [
            {
              "id": "dropdown-closed-value",
              "type": "text",
              "content": "Автоматически",
              "x": 10,
              "y": 7,
              "fill": "$hb:colors.textPrimary",
              "fontFamily": "$hb:typography.family",
              "fontSize": "$hb:typography.label.size",
              "fontWeight": "$hb:typography.label.weight"
            },
            {
              "id": "dropdown-closed-chevron",
              "type": "ref",
              "ref": "hb:hb-icon-chevron-down",
              "x": 216,
              "y": 9,
              "width": 14,
              "height": 14,
              "stroke": "$hb:colors.textSecondary",
              "strokeWidth": 0.98
            }
          ]
        },
        {
          "id": "dropdown-open-title",
          "type": "text",
          "content": "Открыт",
          "x": 304,
          "y": 70,
          "fill": "$hb:colors.textSecondary",
          "fontFamily": "$hb:typography.family",
          "fontSize": "$hb:typography.label.size",
          "fontWeight": "$hb:typography.label.weight"
        },
        {
          "id": "dropdown-open",
          "type": "frame",
          "name": "HbDropdown / Desktop / Closed",
          "x": 304,
          "y": 96,
          "width": 240,
          "height": 32,
          "layout": "none",
          "cornerRadius": "$hb:dimensions.fieldCornerRadius",
          "fill": "$hb:colors.inputFill",
          "children": [
            {
              "id": "dropdown-open-value",
              "type": "text",
              "content": "Автоматически",
              "x": 10,
              "y": 7,
              "fill": "$hb:colors.textPrimary",
              "fontFamily": "$hb:typography.family",
              "fontSize": "$hb:typography.label.size",
              "fontWeight": "$hb:typography.label.weight"
            },
            {
              "id": "dropdown-open-chevron",
              "type": "ref",
              "ref": "hb:hb-icon-chevron-down",
              "x": 216,
              "y": 9,
              "width": 14,
              "height": 14,
