          "x": 304,
          "y": 132,
          "width": 240,
          "height": 104,
          "layout": "none",
          "fill": "$hb:colors.surfaceElevated",
          "cornerRadius": "$hb:dimensions.fieldCornerRadius",
          "children": [
            {
              "id": "dropdown-option-0",
              "type": "frame",
              "name": "Option / Автоматически",
              "x": 4,
              "y": 4,
              "width": 232,
              "height": 28,
              "layout": "none",
              "fill": "$hb:surfaces.selected",
              "cornerRadius": "$hb:dimensions.controlCornerRadius",
              "children": [
                {
                  "id": "dropdown-option-0-label",
                  "type": "text",
                  "content": "Автоматически",
                  "x": 8,
                  "y": 5,
                  "fill": "$hb:colors.textPrimary",
                  "fontFamily": "$hb:typography.family",
                  "fontSize": "$hb:typography.label.size",
                  "fontWeight": "$hb:typography.label.weight"
                },
                {
                  "id": "dropdown-option-check",
                  "type": "ref",
                  "ref": "hb:hb-icon-check",
                  "x": 208,
                  "y": 7,
                  "width": 14,
                  "height": 14,
                  "stroke": "$hb:colors.textPrimary",
                  "strokeWidth": 0.98
                }
              ]
            },
            {
              "id": "dropdown-option-1",
              "type": "frame",
              "name": "Option / Светлая",
              "x": 4,
              "y": 36,
              "width": 232,
              "height": 28,
              "layout": "none",
              "children": [
                {
                  "id": "dropdown-option-1-label",
                  "type": "text",
                  "content": "Светлая",
                  "x": 8,
                  "y": 5,
                  "fill": "$hb:colors.textPrimary",
                  "fontFamily": "$hb:typography.family",
                  "fontSize": "$hb:typography.label.size",
                  "fontWeight": "$hb:typography.label.weight"
                }
              ]
            },
            {
              "id": "dropdown-option-2",
              "type": "frame",
              "name": "Option / Тёмная",
              "x": 4,
              "y": 68,
              "width": 232,
              "height": 28,
              "layout": "none",
              "children": [
                {
                  "id": "dropdown-option-2-label",
                  "type": "text",
                  "content": "Тёмная",
                  "x": 8,
                  "y": 5,
